<Window x:Class="XGecuMetaCleaner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="XGecu Meta Cleaner"
    Width="760"
    Height="360"
    MinWidth="760"
    MinHeight="360"
    FontFamily="Segoe UI"
    FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="-12,-12,-12,8">
            <MenuItem Header="About" Click="About_Click" />
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="File" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="FilePathBox" Grid.Column="1" Height="26" IsReadOnly="True"
                VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            <Button Grid.Column="2" Content="Select File" Width="88" Height="26" Margin="8,0,0,0"
                Click="Browse_Click" />
            <Button Grid.Column="3" Content="Clear File" Width="72" Height="26" Margin="6,0,0,0"
                Click="ClearSelection_Click" />
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,10,0,0"
            Text="Remove meta data of XGecu Programmer and find Windows OEM Key" />

        <Grid Grid.Row="3" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="BackupCheckBox" Content="Create backup before cleaning"
                IsChecked="True" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Clean Meta Data" Width="112" Height="28" Margin="18,0,0,0"
                Click="Clean_Click" />
            <Button x:Name="FindWinKeyButton" Grid.Column="2" Content="Find WinKey" Width="88" Height="28"
                Margin="8,0,0,0"
                Click="FindWinKey_Click" />
            <Button Grid.Column="4" Content="Save Log" Width="76" Height="28" Margin="8,0,0,0"
                Click="SaveLog_Click" />
            <Button Grid.Column="5" Content="Clear Log" Width="76" Height="28" Margin="8,0,0,0"
                Click="ClearLog_Click" />
        </Grid>

        <TextBox x:Name="LogBox" Grid.Row="4" FontFamily="Consolas" FontSize="12"
            IsReadOnly="True" VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </Grid>
</Window>
